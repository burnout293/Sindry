    "balisage": "<svg viewBox=\"0 0 560 150\" preserveAspectRatio=\"xMidYMid slice\" aria-hidden=\"true\"><g class=\"etoiles\"><circle cx=\"155.2\" cy=\"74.7\" r=\"1.2\"/><circle cx=\"367.3\" cy=\"75.7\" r=\"0.7\"/><circle cx=\"534.9\" cy=\"134.8\" r=\"0.8\"/><circle cx=\"279.4\" cy=\"110.6\" r=\"0.7\"/><circle cx=\"218.8\" cy=\"91\" r=\"1.1\"/><circle cx=\"264.5\" cy=\"71.3\" r=\"1.3\"/><circle cx=\"132.7\" cy=\"84.2\" r=\"1.2\"/><circle cx=\"63.4\" cy=\"22.9\" r=\"0.7\"/><circle cx=\"244.2\" cy=\"62.6\" r=\"0.6\"/><circle cx=\"55.7\" cy=\"40.5\" r=\"1.1\"/><circle cx=\"90.8\" cy=\"73.8\" r=\"0.7\"/><circle cx=\"36.4\" cy=\"140.2\" r=\"1.1\"/><circle cx=\"119.4\" cy=\"6.1\" r=\"1.2\"/><circle cx=\"115.7\" cy=\"15.1\" r=\"0.9\"/><circle cx=\"358.5\" cy=\"7\" r=\"1.1\"/><circle cx=\"549\" cy=\"103.1\" r=\"1.5\"/><circle cx=\"118.2\" cy=\"60.8\" r=\"1.3\"/><circle cx=\"231.5\" cy=\"27.9\" r=\"1.2\"/><circle cx=\"401.2\" cy=\"52.1\" r=\"1.5\"/><circle cx=\"77.6\" cy=\"2.9\" r=\"1.3\"/><circle cx=\"12.4\" cy=\"90.6\" r=\"1.2\"/><circle cx=\"370\" cy=\"78.5\" r=\"1.2\"/><circle cx=\"460.4\" cy=\"109.8\" r=\"1.1\"/><circle cx=\"349.5\" cy=\"22.2\" r=\"1.0\"/><circle cx=\"371.6\" cy=\"90\" r=\"0.9\"/><circle cx=\"67\" cy=\"87.5\" r=\"1.3\"/><circle cx=\"196.1\" cy=\"79.8\" r=\"1.0\"/><circle cx=\"77.3\" cy=\"90\" r=\"1.4\"/><circle cx=\"224.1\" cy=\"109.4\" r=\"1.1\"/><circle cx=\"10.8\" cy=\"10.3\" r=\"0.9\"/></g><g transform=\"rotate(-8 280 75)\"><path class=\"trajet\" d=\"M80,75 A200,40 0 1 1 480,75 A200,40 0 1 1 80,75\" pathLength=\"100\"/><path class=\"trace\" d=\"M80,75 A200,40 0 1 1 480,75 A200,40 0 1 1 80,75\" pathLength=\"100\"/><path class=\"balise\" style=\"--u:.25\" d=\"M0,-3.5L3.5,0L0,3.5L-3.5,0Z\"/><path class=\"balise\" style=\"--u:.5\" d=\"M0,-3.5L3.5,0L0,3.5L-3.5,0Z\"/><path class=\"balise\" style=\"--u:.75\" d=\"M0,-3.5L3.5,0L0,3.5L-3.5,0Z\"/><path class=\"satellite\" d=\"M0,-6L6,0L0,6L-6,0Z\"/></g><g transform=\"rotate(-14 280 75)\"><circle class=\"globe\" cx=\"280\" cy=\"75\" r=\"30\"/><ellipse class=\"parallele\" cx=\"280\" cy=\"75\" rx=\"30\" ry=\"7\"/><ellipse class=\"parallele\" cx=\"280\" cy=\"61\" rx=\"25\" ry=\"5.5\"/><ellipse class=\"parallele\" cx=\"280\" cy=\"89\" rx=\"25\" ry=\"5.5\"/><path class=\"meridien\" style=\"--k:0\" d=\"M280,45 A30,30 0 0 1 280,105\"/><path class=\"meridien\" style=\"--k:1\" d=\"M280,45 A30,30 0 0 1 280,105\"/><path class=\"meridien\" style=\"--k:2\" d=\"M280,45 A30,30 0 0 1 280,105\"/><path class=\"meridien\" style=\"--k:3\" d=\"M280,45 A30,30 0 0 1 280,105\"/><path class=\"meridien\" style=\"--k:4\" d=\"M280,45 A30,30 0 0 1 280,105\"/><path class=\"meridien\" style=\"--k:5\" d=\"M280,45 A30,30 0 0 1 280,105\"/><path class=\"meridien\" style=\"--k:6\" d=\"M280,45 A30,30 0 0 1 280,105\"/><path class=\"meridien\" style=\"--k:7\" d=\"M280,45 A30,30 0 0 1 280,105\"/><path class=\"meridien\" style=\"--k:8\" d=\"M280,45 A30,30 0 0 1 280,105\"/><path class=\"meridien\" style=\"--k:9\" d=\"M280,45 A30,30 0 0 1 280,105\"/><path class=\"meridien\" style=\"--k:10\" d=\"M280,45 A30,30 0 0 1 280,105\"/><path class=\"meridien\" style=\"--k:11\" d=\"M280,45 A30,30 0 0 1 280,105\"/></g></svg><p class=\"pct\">{{pourcentage}}</p>",
    "css": "svg { width: 100%; height: 100%; display: block; }\n.etoiles circle { fill: var(--text); opacity: .4; }\n/* The path, the trail travelled, and the satellite that follows it. */\n.trajet { fill: none; stroke: var(--rouage-a); stroke-width: 1; stroke-dasharray: .5 1.2; opacity: .6; }\n.trace { fill: none; stroke: var(--acc); stroke-width: 2.4; stroke-linecap: round; stroke-dasharray: calc(var(--pct) * 1px) 100px; opacity: clamp(0, var(--pct), 1); filter: drop-shadow(0 0 4px var(--acc)); }\n.balise, .satellite { offset-path: path('M80,75 A200,40 0 1 1 480,75 A200,40 0 1 1 80,75'); offset-rotate: 0deg; }\n.satellite { offset-distance: calc(var(--p) * 100%); fill: var(--acc); filter: drop-shadow(0 0 5px var(--acc)); }\n/* A beacon lights up once the satellite passes it. */\n.balise { offset-distance: calc(var(--u) * 100%); fill: color-mix(in srgb, var(--acc) clamp(0%, (var(--p) - var(--u)) * 100000%, 100%), var(--rouage-a)); opacity: clamp(.45, (var(--p) - var(--u)) * 1000 + .45, 1); }\n/* The planet turns slowly: twelve meridians, each in front (bright) then behind (pale). */\n.globe { fill: var(--bg); stroke: var(--rouage-a); stroke-width: 1.4; }\n.parallele { fill: none; stroke: var(--rouage-a); stroke-width: .8; opacity: .35; }\n.meridien { fill: none; stroke: var(--rouage-a); stroke-width: 1; transform-origin: 280px 75px; animation: globe 36s cubic-bezier(.37, 0, .63, 1) infinite; animation-delay: calc((var(--depuis) + var(--k) * 3) * -1s); }\n@keyframes globe { 0% { transform: scaleX(-1); opacity: .8; } 49.9% { opacity: .8; } 50% { transform: scaleX(1); opacity: .12; } 100% { transform: scaleX(-1); opacity: .12; } }\n.pct { position: absolute; right: 22px; bottom: 14px; margin: 0; font: 600 13px 'Segoe UI', system-ui, sans-serif; letter-spacing: .18em; color: var(--text); }"
