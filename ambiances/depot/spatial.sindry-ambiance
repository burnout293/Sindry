    "css": ":root { --etoile: rgba(220, 235, 255, .8); }\n[data-mode=\"clair\"] { --etoile: rgba(30, 60, 100, .3); }\n.sp-etoiles { position: absolute; inset: 0; background-image: radial-gradient(1.6px 1.6px at 20px 30px, var(--etoile) 50%, transparent 51%), radial-gradient(1px 1px at 140px 90px, var(--etoile) 50%, transparent 51%), radial-gradient(1px 1px at 230px 170px, var(--etoile) 50%, transparent 51%), radial-gradient(1.6px 1.6px at 60px 220px, var(--etoile) 50%, transparent 51%), radial-gradient(1px 1px at 300px 40px, var(--etoile) 50%, transparent 51%), radial-gradient(1px 1px at 190px 250px, var(--etoile) 50%, transparent 51%), radial-gradient(1.2px 1.2px at 280px 140px, var(--etoile) 50%, transparent 51%); background-size: 340px 260px; animation: sp-derive 140s linear infinite; }\n@keyframes sp-derive { to { background-position: -340px 0; } }\n.sp-trainee { position: absolute; left: 0; height: 1px; opacity: 0; background: linear-gradient(90deg, transparent, var(--rouage-a), transparent); animation: sp-trainee 7s ease-in infinite; }\n.sp-trainee.t1 { top: 120px; width: 180px; animation-delay: 1s; }\n.sp-trainee.t2 { top: 190px; width: 120px; animation-delay: 4.2s; }\n@keyframes sp-trainee { 0% { transform: translateX(-200px); opacity: 0; } 8% { opacity: .7; } 22%, 100% { transform: translateX(2400px); opacity: 0; } }\n.sp-holo { position: absolute; left: 50%; bottom: -260px; width: 560px; height: 560px; margin-left: -280px; }\n.sp-holo svg { width: 100%; height: 100%; overflow: visible; }\n.sp-contour { fill: color-mix(in srgb, var(--rouage-a) 9%, transparent); stroke: var(--rouage-a); stroke-width: 1.4; opacity: .85; }\n.sp-lat { fill: none; stroke: var(--rouage-a); stroke-width: .8; opacity: .4; }\n.sp-mer { fill: none; stroke: var(--rouage-a); stroke-width: .8; opacity: .5; transform-box: fill-box; transform-origin: center; animation: sp-tourne 14s linear infinite; }\n@keyframes sp-tourne { 0% { transform: scaleX(1); } 25% { transform: scaleX(0); } 50% { transform: scaleX(-1); } 75% { transform: scaleX(0); } 100% { transform: scaleX(1); } }\n.sp-orbite { fill: none; stroke: var(--acc); stroke-width: 1; stroke-dasharray: 3 6; opacity: .7; }\n.sp-anneau { position: absolute; left: 50%; bottom: 8px; width: 760px; height: 70px; margin-left: -380px; border-radius: 50%; border: 1.5px solid var(--rouage-a); opacity: .45; box-shadow: 0 0 30px color-mix(in srgb, var(--rouage-a) 20%, transparent), inset 0 0 30px color-mix(in srgb, var(--rouage-a) 20%, transparent); }\n"
