{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sindry",
  "version": "2.0.5",
  "identifier": "com.sindry.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Sindry",
        "width": 1180,
        "height": 760,
        "minWidth": 920,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "installeur/crochets.nsh",
        "template": "installeur/installer.nsi",
        "languages": ["English", "French"]
      }
    },
    "resources": {
      "../tools/categories.json": "categories.json",
      "../tools/lots.json": "lots.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "licenseFile": "../LICENSE"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5RUJGMDI2M0VCQjkxMEIKUldRTGticytKdkRyaVlKZlE4d21HcHArdk96Vjgvbjh3bWNvVlc1eTRHNHFaZndWeWkrNThFUGoK",
      "endpoints": [
        "https://github.com/burnout293/Sindry/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
